{
    // 网页版云终末地门户 https://endfield.hypergryph.com/cloud
    //
    // 门户是响应式 React SPA，同一元素在「未登录落地页」与「已登录账号面板」下位置不同，
    // 因此只给实测过坐标的节点写 roi，其余一律整帧 OCR，避免把未标定的坐标当成已标定。
    // 门户 UI 只有国服中文，不存在多语言展开需求。每个门户 OCR 节点的 expected 里都留一条 @i18n-skip：
    // 这两个 overlay 现在不在 tools/i18n/sync_ocr_expected.py 的扫描路径里，但「开始游戏」这类文案
    // 与游戏内文案同形，一旦将来把 overlay 加进扫描路径，没有标记就会被按语言表展开成四语。
    "CloudBrowserPortalStartGame": {
        "desc": "门户：点击开始游戏",
        // 点击到遮罩出现之间有一到两秒的空窗，这期间按钮还在、NextList 会再命中一次：
        // 2026-10-24 内嵌真机 07:55 那轮连续点了 35.7s / 39.5s 两下，服务端 1.4 秒内收到两次 dispatch，
        // 随后首个会话的 <video> 轨道 ended、页面卡在启动遮罩。加 post_delay 把连点压掉；
        // 真点不动也没关系，两秒后下一轮会再点。
        "post_delay": 2000,
        "recognition": {
            "type": "OCR",
            "param": {
                // 「开始游戏」按钮贴在页面右下角，y 随窗口高度浮动，不能按单一实测值卡死：
                // 2026-10-23 真机（Edge --app，客户区 1280x720，抓帧 1280x720）实测文本框 (1124,678)-(1197,702)，
                // 按钮胶囊 (1056,664)-(1216,704)；早期在带标签页的浏览器窗口（抓帧高约 630）实测 (995,563)-(1175,612)。
                // 2026-10-23 内嵌真机（MaaFwVirtualDisplay 1280x720，density 240）实测文本框 (1045,660)-(1153,692)，
                // 说明这条 roi 在桌面与内嵌两种排版下都成立，不需要按 density 折算。
                // 故取覆盖右下象限的宽松 roi，同时容纳几种几何；左侧的「下载游戏」由 expected 过滤，不会误命中。
                "roi": [
                    860,
                    500,
                    420,
                    220
                ],
                "expected": [
                    // @i18n-skip
                    "开始游戏"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "CloudBrowserDialogConfirmButton": {
        "desc": "门户弹窗：知道了按钮",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    // @i18n-skip
                    "知道了"
                ]
            }
        }
    },
    "CloudBrowserSpeedtestFailed": {
        // 蔚领 SDK 对 8 个节点测速全部超时后 selectDefaultNode 返回 6544 并弹窗。
        // 低配机器上这是主线程被渲染拖慢造成的假性高 RTT，关弹窗重试即可，故设为可重试分支。
        "desc": "门户：测速失败，关闭弹窗后重试",
        "max_hit": 5,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloudBrowserSpeedtestFailedText",
                    "CloudBrowserDialogConfirmButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "CloudBrowserSpeedtestFailedText": {
        // 括号内错误码随失败原因变化，OCR 对整句不稳定，截断匹配
        "desc": "门户：测速失败文案",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    // "测速失败，请稍后再试(6544)"
                    // @i18n-skip
                    "测速失败"
                ]
            }
        }
    },
    "CloudBrowserNetworkAbnormal": {
        "desc": "门户：网络连接异常，关闭弹窗后重试",
        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloudBrowserNetworkAbnormalText",
                    "CloudBrowserDialogConfirmButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "CloudBrowserNetworkAbnormalText": {
        "desc": "门户：网络连接异常文案",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    // @i18n-skip
                    "网络连接异常，请检查网络连接后重试"
                ]
            }
        }
    },
    "CloudBrowserSessionIdleEnded": {
        // 云客户端自己的弹窗（画在 <video> 里，不是门户 HTML）：长时间没人操作后云会话被回收，
        // 整屏变黑只剩「由于您长时间未操作，本次游戏已自动结束 / 知道了」。
        // 2026-10-24 实测：08:28 到达标题页后一直没人动，12:22 虚拟屏上就是这个弹窗；
        // 点「知道了」会退出客户端并回到已登录门户（账号面板与右下角「开始游戏」都在，免费时长没变）。
        // 不点掉它的话，重跑任务时整屏没有任何门户节点能命中，只会空转到判失败。
        // 文案在视频流里，几何恒为 1280×720，因此直接复用门户的「知道了」按钮节点定位。
        "desc": "云客户端：长时间未操作，会话已结束，关掉提示退回门户",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloudBrowserSessionIdleEndedText",
                    "CloudBrowserDialogConfirmButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "CloudBrowserSessionIdleEndedText": {
        // "由于您长时间未操作，本次游戏已自动结束"
        "desc": "云客户端：长时间未操作提示文案",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    // @i18n-skip
                    "长时间未操作"
                ]
            }
        }
    },
    "CloudBrowserGameStarting": {
        // 点了「开始游戏」之后门户会盖一层全屏遮罩转圈，等云 Windows 实例把客户端拉起来。
        // 2026-10-24 内嵌真机实测：从点击到画面出帧用了 15~20 秒，慢的时候更久，期间整页没有可识别元素，
        // 只有一句「游戏启动中，请耐心等待」。不认这个中间态，OpenGame.next 会在 20 秒后整条判失败，
        // 而云端会话其实还在正常启动（同一轮 08:05 的会话在 20 秒内就串上了标题页）。
        // 不写 roi：遮罩文案水平居中，外置桌面窗口高度不同（720 / 630）时 y 会浮动，内嵌屏与手机版更不一样；
        // 这句话不会出现在别处，整帧 OCR 足够且不会误命中别的节点。
        "desc": "门户：云实例启动中，原地等待",
        "rate_limit": 2000,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    // @i18n-skip
                    "游戏启动中"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        }
    },
    "CloudBrowserPortalReconnecting": {
        // 云实例是单会话：同一账号被另一个客户端挤掉后，门户会停在转圈的「游戏正在重连中」。
        // 只识别不动作，供上层把它当作等待态而非失败态，同时避免对着转圈画面空转。
        "desc": "门户：游戏正在重连中",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    // @i18n-skip
                    "游戏正在重连中"
                ]
            }
        }
    },
    "CloudBrowserPortalLoggedIn": {
        // 账号面板文本形如「通行证UID：1234567890」，UID 随账号变化，故截断匹配
        "desc": "门户：已登录",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    // "通行证UID：1234567890"
                    // @i18n-skip
                    "通行证UID"
                ]
            }
        }
    },
    "CloudBrowserPortalLoginModal": {
        "desc": "门户：鹰角登录框仍在，会话已失效",
        "recognition": {
            "type": "OCR",
            "param": {
                // 登录框在页面里垂直居中，y 同样随窗口高度浮动，而且内嵌 WebView 与桌面浏览器的排版并不一致：
                // 2026-10-23 桌面真机（Edge --app，客户区 1280x720）实测「请输入手机号」(481,276)-(580,295)，
                // 早期带标签页窗口（抓帧高约 630）实测 (478,258)-(573,287)；
                // 2026-10-23 内嵌真机（MaaFwVirtualDisplay 1280x720，density 240）实测 (402,211)-(549,239)。
                // 内嵌这一帧把旧 roi 的左边界 420 切进了「请」字里，OCR 直接检不出整行，故 roi 必须同时容纳
                // x 从 402 起、y 从 211 起的内嵌几何与桌面几何；下界留到 360，仍能容住 y 309 起的「请输入验证码」，
                // 那一行文本与 expected 不同，不会误命中。
                "roi": [
                    380,
                    180,
                    520,
                    180
                ],
                "expected": [
                    // @i18n-skip
                    "请输入手机号"
                ]
            }
        }
    }
}
