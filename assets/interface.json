{
    "interface_version": 2,
    "languages": {
        "zh_cn": "locales/interface/zh_cn.json",
        "zh_tw": "locales/interface/zh_tw.json",
        "en_us": "locales/interface/en_us.json",
        "ja_jp": "locales/interface/ja_jp.json",
        "ko_kr": "locales/interface/ko_kr.json"
    },
    "name": "MaaEnd",
    "icon": "locales/MaaEnd-Tiny.png",
    "mirrorchyan_rid": "MaaEnd",
    "mirrorchyan_multiplatform": true,
    "github": "https://github.com/MaaEnd/MaaEnd",
    "version": "v0.1.0",
    "contact": "$contact.file",
    "license": "locales/LICENSE_SHORT.md",
    "welcome": "https://end.maafw.com/anno.md",
    "description": "$description.file",
    "telemetry": {
        "sentry": {
            "dsn": "https://bd7fd739c3764eb264d3bfbb298cb56b@o4511806947065856.ingest.us.sentry.io/4511806958665728"
        }
    },
    "controller": [
        {
            "name": "Win32-Front",
            "label": "$controller.Win32-Front.label",
            "description": "$controller.Win32-Front.description",
            "type": "Win32",
            "permission_required": true,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "Endfield",
                "screencap": "ScreenDC",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        },
        {
            "name": "ADB",
            "label": "$controller.ADB.label",
            "description": "$controller.ADB.description",
            "type": "Adb",
            "attach_resource_path": [
                "./resource_adb"
            ]
        },
        {
            "name": "CloudADB",
            "label": "$controller.CloudADB.label",
            "description": "$controller.CloudADB.description",
            "type": "Adb",
            "attach_resource_path": [
                "./resource_adb",
                "./resource_cloud_adb"
            ]
        },
        {
            "name": "CloudBrowser",
            "label": "$controller.CloudBrowser.label",
            "description": "$controller.CloudBrowser.description",
            "type": "Win32",
            "permission_required": true,
            "attach_resource_path": [
                "./resource_cloud_browser"
            ],
            "win32": {
                "class_regex": "Chrome_WidgetWin_1",
                // pretask CloudBrowserLaunch 以 --app= 打开门户，窗口标题即页面标题《云·终末地》官方网站
                "window_regex": "云·终末地",
                // FramePool（Windows.Graphics.Capture 抓窗口帧）：2026-10-23 真机验证，窗口被其他窗口遮挡、
                // 不在前台时仍能拿到完整页面，且不会动窗口 z-order。
                // 不要用 ScreenDC：它抓的是屏幕像素，每次识别前都要把门户提到最上层（抢用户 z-order），
                // 一旦有置顶窗口（任务管理器、录屏/输入法浮层）就会把遮挡物一起截进来导致识别全丢；
                // GDI 在 Chromium 上直接全黑，DXGI_DesktopDup(_Window) 在部分集显上 DuplicateOutput 返回 E_ACCESSDENIED。
                "screencap": "FramePool",
                // Seize 移动真实光标、发送真实按键，页面里的 WebRTC 输入与鼠标视角才拿得到事件
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        },
        {
            // type 仍是标准 Win32：PI 协议没有浏览器类型，MaaPiCli 遇到未知 type 会拒绝整个 interface。
            // embedded_browser 是 MaaFwApp 的扩展标记，桌面端忽略它，照旧按下面的 win32 配置抓 Chrome 窗口；
            // MaaFwApp 看到标记则在虚拟屏里内嵌 WebView，不依赖外置浏览器
            "name": "CloudBrowserPC",
            "label": "$controller.CloudBrowserPC.label",
            "description": "$controller.CloudBrowserPC.description",
            "type": "Win32",
            "permission_required": true,
            "attach_resource_path": [
                "./resource_cloud_browser"
            ],
            "win32": {
                "class_regex": "Chrome_WidgetWin_1",
                "window_regex": "云·终末地",
                // 同 CloudBrowser：Chromium 窗口一律用 FramePool，理由见上面的注释
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            },
            "embedded_browser": {
                // 同一个门户按「开始游戏」点击的 pointerType 选电脑/手机云平台，pc 模式注入原生鼠标事件
                "mode": "pc"
            }
        },
        {
            // 手机云平台跑的是安卓客户端，所以叠加 resource_adb；
            // 门户在手机版布局下按钮位置不同，由 resource_cloud_browser_mobile 覆盖
            "name": "CloudBrowserMobile",
            "label": "$controller.CloudBrowserMobile.label",
            "description": "$controller.CloudBrowserMobile.description",
            "type": "Win32",
            "permission_required": true,
            "attach_resource_path": [
                "./resource_adb",
                "./resource_cloud_browser",
                "./resource_cloud_browser_mobile"
            ],
            "win32": {
                "class_regex": "Chrome_WidgetWin_1",
                "window_regex": "云·终末地",
                // 同 CloudBrowser：Chromium 窗口一律用 FramePool，理由见上面的注释
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            },
            "embedded_browser": {
                "mode": "mobile"
            }
        },
        {
            "name": "PlayCover",
            "type": "PlayCover",
            "attach_resource_path": [
                "./resource_adb",
                "./resource_playcover"
            ],
            "playcover": {
                "uuid": "maa.playcover"
            }
        },
        {
            "name": "Linux-Gamescope",
            "label": "$controller.Linux-Gamescope.label",
            "description": "$controller.Linux-Gamescope.description",
            "type": "Linux",
            "attach_resource_path": [
                "./resource_linux"
            ],
            "linux": {
                "input": "Libei",
                "screencap": "PipeWire",
                "pipewire_source": "Gamescope",
                "use_win32_vk_code": true
            }
        },
        {
            "name": "Linux-ScreenCast",
            "label": "$controller.Linux-ScreenCast.label",
            "description": "$controller.Linux-ScreenCast.description",
            "type": "Linux",
            "attach_resource_path": [
                "./resource_linux"
            ],
            "linux": {
                "input": "UInput",
                "screencap": "PipeWire",
                "pipewire_source": "Portal",
                "use_win32_vk_code": true
            }
        },
        {
            "name": "Linux-Wlroots",
            "label": "$controller.Linux-Wlroots.label",
            "description": "$controller.Linux-Wlroots.description",
            "type": "Linux",
            "attach_resource_path": [
                "./resource_linux"
            ],
            "linux": {
                "input": "Wlr",
                "screencap": "Wlr",
                "use_win32_vk_code": true
            }
        },
        {
            "name": "MacOS-Front",
            "label": "$controller.MacOS-Front.label",
            "description": "$controller.MacOS-Front.description",
            "type": "MacOS",
            "attach_resource_path": [
                "./resource_macos"
            ],
            "macos": {
                "title_regex": "Endfield",
                "screencap": "ScreenCaptureKit",
                "input": "GlobalEvent"
            }
        },
        {
            "name": "MacOS-Background",
            "label": "$controller.MacOS-Background.label",
            "description": "$controller.MacOS-Background.description",
            "type": "MacOS",
            "attach_resource_path": [
                "./resource_macos"
            ],
            "macos": {
                "title_regex": "Endfield",
                "screencap": "ScreenCaptureKit",
                "input": "PostToPid"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "label": "$resource.CN.label",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": [
